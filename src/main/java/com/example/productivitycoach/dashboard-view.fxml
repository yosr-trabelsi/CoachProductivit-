<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600.0" prefWidth="900.0"
            style="-fx-background-color: #f4f6f9;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.example.productivitycoach.DashboardController">

    <left>
        <VBox prefWidth="200.0" prefHeight="600.0" spacing="5.0"
              style="-fx-background-color: #2c3e50; -fx-padding: 25 12 25 12;"
              BorderPane.alignment="CENTER">
            <children>
                <Label text="🚀 Productivity"
                       style="-fx-text-fill: white; -fx-font-size: 16px; -fx-font-weight: bold;" />
                <Label text="    Coach"
                       style="-fx-text-fill: #3498db; -fx-font-size: 16px;
                              -fx-font-weight: bold; -fx-padding: 0 0 10 0;" />

                <HBox prefHeight="1.0" prefWidth="176.0"
                      style="-fx-background-color: #4a6278; -fx-padding: 0 0 10 0;" />

                <!-- ✅ Bouton Dashboard -->
                <Button mnemonicParsing="false" text="🏠  Dashboard"
                        onAction="#onShowProfil"
                        prefWidth="176.0" prefHeight="42.0"
                        style="-fx-background-color: #3d5166; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 15;" />

                <Button mnemonicParsing="false" text="📋  Mes Tâches"
                        onAction="#onShowTasks"
                        prefWidth="176.0" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 15;" />

                <Button mnemonicParsing="false" text="📅  Calendrier"
                        onAction="#onShowCalendrier"
                        prefWidth="176.0" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 15;" />

                <Button mnemonicParsing="false" text="📊  Statistiques"
                        onAction="#onShowStatistiques"
                        prefWidth="176.0" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 15;" />

                <Button mnemonicParsing="false" text="🤖  Assistant IA"
                        onAction="#onShowIA"
                        prefWidth="176.0" prefHeight="42.0"
                        style="-fx-background-color: #6c3483; -fx-text-fill: white;
                               -fx-font-size: 13px; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-alignment: CENTER-LEFT;
                               -fx-font-weight: bold; -fx-padding: 0 0 0 15;" />

                <HBox prefHeight="1.0" prefWidth="176.0"
                      style="-fx-background-color: #4a6278;" />

                <Button mnemonicParsing="false" text="👤  Mon Profil"
                        onAction="#onShowProfil"
                        prefWidth="176.0" prefHeight="42.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #bdc3c7;
                               -fx-font-size: 13px; -fx-background-radius: 8;
                               -fx-cursor: hand; -fx-alignment: CENTER-LEFT;
                               -fx-padding: 0 0 0 15;" />
            </children>
        </VBox>
    </left>

    <center>
        <StackPane fx:id="contentArea" BorderPane.alignment="CENTER">
            <children>
                <!-- ✅ homeView visible par défaut -->
                <VBox fx:id="homeView" spacing="20.0"
                      style="-fx-padding: 35 35 35 35; -fx-background-color: #f4f6f9;">

                    <Label text="👋  Bonjour !"
                           style="-fx-font-size: 26px; -fx-font-weight: bold;
                                  -fx-text-fill: #2c3e50;" />
                    <Label text="Bienvenue sur votre Coach de Productivité personnel."
                           style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;" />

                    <HBox prefHeight="2.0" style="-fx-background-color: #dce1e7;" />

                    <!-- Cartes raccourcis -->
                    <HBox spacing="15.0">
                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                                     -fx-padding: 20; -fx-spacing: 8; -fx-pref-width: 150;
                                     -fx-effect: dropshadow(gaussian, #d0d0d0, 6, 0, 0, 2);">
                            <Label text="📋" style="-fx-font-size: 24px;" />
                            <Label text="Mes Tâches"
                                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                            <Label text="Gérer vos tâches"
                                   style="-fx-font-size: 11px; -fx-text-fill: #bdc3c7;" />
                            <Button text="Accéder →" onAction="#onShowTasks"
                                    style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                           -fx-background-radius: 6; -fx-cursor: hand;
                                           -fx-font-size: 11px;" />
                        </VBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                                     -fx-padding: 20; -fx-spacing: 8; -fx-pref-width: 150;
                                     -fx-effect: dropshadow(gaussian, #d0d0d0, 6, 0, 0, 2);">
                            <Label text="📅" style="-fx-font-size: 24px;" />
                            <Label text="Calendrier"
                                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                            <Label text="Voir le planning"
                                   style="-fx-font-size: 11px; -fx-text-fill: #bdc3c7;" />
                            <Button text="Accéder →" onAction="#onShowCalendrier"
                                    style="-fx-background-color: #27ae60; -fx-text-fill: white;
                                           -fx-background-radius: 6; -fx-cursor: hand;
                                           -fx-font-size: 11px;" />
                        </VBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                                     -fx-padding: 20; -fx-spacing: 8; -fx-pref-width: 150;
                                     -fx-effect: dropshadow(gaussian, #d0d0d0, 6, 0, 0, 2);">
                            <Label text="📊" style="-fx-font-size: 24px;" />
                            <Label text="Statistiques"
                                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                            <Label text="Suivre vos progrès"
                                   style="-fx-font-size: 11px; -fx-text-fill: #bdc3c7;" />
                            <Button text="Accéder →" onAction="#onShowStatistiques"
                                    style="-fx-background-color: #e67e22; -fx-text-fill: white;
                                           -fx-background-radius: 6; -fx-cursor: hand;
                                           -fx-font-size: 11px;" />
                        </VBox>

                        <VBox style="-fx-background-color: white; -fx-background-radius: 12;
                                     -fx-padding: 20; -fx-spacing: 8; -fx-pref-width: 150;
                                     -fx-effect: dropshadow(gaussian, #d0d0d0, 6, 0, 0, 2);">
                            <Label text="🤖" style="-fx-font-size: 24px;" />
                            <Label text="Assistant IA"
                                   style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;" />
                            <Label text="Planifier avec l'IA"
                                   style="-fx-font-size: 11px; -fx-text-fill: #bdc3c7;" />
                            <Button text="Accéder →" onAction="#onShowIA"
                                    style="-fx-background-color: #6c3483; -fx-text-fill: white;
                                           -fx-background-radius: 6; -fx-cursor: hand;
                                           -fx-font-size: 11px;" />
                        </VBox>
                    </HBox>

                    <HBox prefHeight="2.0" style="-fx-background-color: #dce1e7;" />

                    <Label text="👤  Mon Profil de Productivité"
                           style="-fx-font-size: 16px; -fx-font-weight: bold;
                                  -fx-text-fill: #2c3e50;" />

                    <GridPane hgap="20.0" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints prefWidth="120.0" />
                            <ColumnConstraints prefWidth="400.0" />
                        </columnConstraints>

                        <Label text="🎯  Objectifs"
                               style="-fx-font-weight: bold; -fx-text-fill: #34495e;"
                               GridPane.rowIndex="0" />
                        <TextArea fx:id="objectifsArea" prefHeight="60.0"
                                  promptText="Ex: Obtenir mon diplôme..."
                                  style="-fx-background-radius: 6; -fx-border-color: #dce1e7;
                                         -fx-border-radius: 6; -fx-font-size: 12px;"
                                  GridPane.columnIndex="1" GridPane.rowIndex="0" />

                        <Label text="⏱  Rythme"
                               style="-fx-font-weight: bold; -fx-text-fill: #34495e;"
                               GridPane.rowIndex="1" />
                        <ChoiceBox fx:id="rythmeChoice" prefWidth="200.0"
                                   style="-fx-background-radius: 6;"
                                   GridPane.columnIndex="1" GridPane.rowIndex="1" />

                        <Label text="⚙️  Préférences"
                               style="-fx-font-weight: bold; -fx-text-fill: #34495e;"
                               GridPane.rowIndex="2" />
                        <TextArea fx:id="prefsArea" prefHeight="60.0"
                                  promptText="Ex: Travailler le matin..."
                                  style="-fx-background-radius: 6; -fx-border-color: #dce1e7;
                                         -fx-border-radius: 6; -fx-font-size: 12px;"
                                  GridPane.columnIndex="1" GridPane.rowIndex="2" />
                    </GridPane>

                    <Button mnemonicParsing="false"
                            onAction="#onUpdateProfileClick"
                            text="💾  Sauvegarder le profil"
                            prefHeight="38.0" prefWidth="200.0"
                            style="-fx-background-color: #2c3e50; -fx-text-fill: white;
                                   -fx-font-weight: bold; -fx-font-size: 13px;
                                   -fx-background-radius: 8; -fx-cursor: hand;" />
                </VBox>
            </children>
        </StackPane>
    </center>

</BorderPane>