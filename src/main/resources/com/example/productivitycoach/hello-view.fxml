<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<!-- FIX 1: javafx/25 → javafx -->
<!-- FIX 2: HelloController → RegisterController -->
<VBox alignment="CENTER" spacing="15.0"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx"
      fx:controller="com.example.productivitycoach.RegisterController">

   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>

   <Label style="-fx-font-size: 20px; -fx-font-weight: bold;"
          text="Créer un compte" />

   <Label style="-fx-font-weight: bold;" text="Nom d'utilisateur" />
   <TextField fx:id="usernameField" maxWidth="250"
              promptText="Ex: Mariem_Dev" />

   <Label style="-fx-font-weight: bold;" text="Email" />
   <TextField fx:id="emailField" maxWidth="250"
              promptText="Ex: test@gmail.com" />

   <Label style="-fx-font-weight: bold;" text="Mot de passe" />
   <PasswordField fx:id="passwordField" maxWidth="250" />

   <Button onAction="#onRegisterButtonClick"
           style="-fx-background-color: #2ecc71; -fx-text-fill: white;
                   -fx-font-weight: bold; -fx-cursor: hand;"
           text="S'inscrire" />

   <Hyperlink onAction="#onLoginLinkClick"
              text="Déjà un compte ? Se connecter" />

</VBox>