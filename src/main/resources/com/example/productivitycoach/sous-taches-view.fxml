<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0.0"
      style="-fx-background-color: #f0f4f8; -fx-padding: 30 30 30 30;"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.example.productivitycoach.SousTachesController">

    <!-- Header -->
    <Label text="📌  Mes Sous-Tâches"
           style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a202c; -fx-padding: 0 0 6 0;" />
    <HBox prefHeight="2.0"
          style="-fx-background-color: linear-gradient(to right, #059669, #f0f4f8); -fx-padding: 0 0 18 0;" />

    <!-- Tache selector card -->
    <VBox spacing="10.0"
          style="-fx-background-color: #ffffff; -fx-background-radius: 14;
                 -fx-padding: 20 22 20 22;
                 -fx-border-color: #059669; -fx-border-width: 0 0 0 4;
                 -fx-border-radius: 14;
                 -fx-effect: dropshadow(gaussian, #05966920, 8, 0, 0, 3);">
        <Label text="Sélectionnez une tâche pour voir ses sous-tâches :"
               style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 13px;" />
        <ChoiceBox fx:id="tacheSelector" prefWidth="420.0"
                   style="-fx-background-color: #f8fafc; -fx-background-radius: 8;" />
        <Label fx:id="lblTacheSelectionnee" text=""
               style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #059669;" />
    </VBox>

    <!-- Count + table label -->
    <HBox spacing="12.0" style="-fx-padding: 18 0 8 0;" alignment="CENTER_LEFT">
        <Label text="📂  Liste des sous-tâches"
               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
        <Label fx:id="lblCount" text=""
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;
                      -fx-background-color: #e6f7f8; -fx-background-radius: 20;
                      -fx-padding: 2 10 2 10;" />
    </HBox>

    <!-- Table -->
    <TableView fx:id="sousTachesTable" prefHeight="320.0"
               style="-fx-background-color: #ffffff; -fx-background-radius: 10;
                      -fx-border-color: #e2e8f0; -fx-border-radius: 10;">
        <columns>
            <TableColumn fx:id="colTitre" prefWidth="420.0" text="Titre de la sous-tâche" />
            <TableColumn fx:id="colPriorite" prefWidth="140.0" text="Priorité" />
            <!-- delete column added programmatically in controller -->
        </columns>
    </TableView>

</VBox>
