<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="16.0"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx"
      fx:controller="com.example.productivitycoach.LoginController"
      style="-fx-background-color: #f0f4f8; -fx-min-width: 400; -fx-min-height: 400;">

    <padding><Insets bottom="50.0" left="60.0" right="60.0" top="50.0" /></padding>

    <!-- Logo -->
    <VBox alignment="CENTER" spacing="2.0">
        <Label text="⚡ Productivity Coach"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #1a202c;" />
        <Label text="Connectez-vous à votre espace"
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;" />
    </VBox>

    <HBox prefHeight="2.0" prefWidth="280.0"
          style="-fx-background-color: linear-gradient(to right, #0694a2, #6d28d9);" />

    <!-- Form card -->
    <VBox spacing="12.0" alignment="CENTER"
          style="-fx-background-color: #ffffff; -fx-background-radius: 14;
                 -fx-padding: 30 36 30 36;
                 -fx-border-color: #e2e8f0; -fx-border-width: 1; -fx-border-radius: 14;
                 -fx-effect: dropshadow(gaussian, #1a202c18, 10, 0, 0, 3);">

        <Label text="Nom d'utilisateur"
               style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 12px;" />
        <TextField fx:id="loginUsername" maxWidth="260"
                   promptText="Votre nom d'utilisateur"
                   style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;
                          -fx-border-radius: 8; -fx-background-radius: 8;
                          -fx-font-size: 13px; -fx-padding: 8 12 8 12;" />

        <Label text="Mot de passe"
               style="-fx-font-weight: bold; -fx-text-fill: #64748b; -fx-font-size: 12px;" />
        <PasswordField fx:id="loginPassword" maxWidth="260"
                       promptText="Votre mot de passe"
                       style="-fx-background-color: #f8fafc; -fx-border-color: #e2e8f0;
                              -fx-border-radius: 8; -fx-background-radius: 8;
                              -fx-font-size: 13px; -fx-padding: 8 12 8 12;" />

        <Button onAction="#onLoginButtonClick" prefWidth="200.0" prefHeight="40.0"
                text="Se connecter →"
                style="-fx-background-color: #0694a2; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-font-size: 13px;
                       -fx-background-radius: 10; -fx-cursor: hand;" />

        <Hyperlink onAction="#onRegisterLinkClick"
                   text="Pas encore de compte ? S'inscrire"
                   style="-fx-text-fill: #6d28d9; -fx-font-size: 12px;" />
    </VBox>

</VBox>
